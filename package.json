{
  "name": "handtracking-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && vite --host 127.0.0.1",
    "build": "npm run check && npm run assets && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --experimental-strip-types server/index.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:sync": "node --experimental-strip-types --test tests/scene-sync.integration.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
